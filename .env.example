# Copy to .env and fill secrets before starting the stack:
#   cp .env.example .env && ./scripts/ubuntu/generate-secrets.sh

# Random 96+ char secret (required by Graylog)
GRAYLOG_PASSWORD_SECRET=

# SHA-256 of your admin password (echo -n 'YourPass' | sha256sum)
GRAYLOG_ROOT_PASSWORD_SHA2=

# Plaintext admin password (for bootstrap scripts only — do not commit)
GRAYLOG_ROOT_PASSWORD=ChangeMeStrong!

# How browsers reach Graylog (use Ubuntu bridged IP in the lab)
GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9000/

# Live dashboard (scripts/ubuntu/start-dashboard.sh)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8088
# auto | always | never — always forces demo feed even if Graylog is up
AJSIEM_DEMO=auto
AJSIEM_POLL_SECONDS=2.5

# OpenSearch demo admin password (lab only)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=AjSiemLab_ChangeMe1!

TZ=UTC

# Kali → Ubuntu forwarding target (set on Kali)
SIEM_SERVER_IP=192.168.1.50
